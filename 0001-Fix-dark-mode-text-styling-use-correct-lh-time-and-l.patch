From 146a6533e8098aa89b3f97590f641dfeca00a6c1 Mon Sep 17 00:00:00 2001
From: "Jory A. Pratt" <geekypenguin@gmail.com>
Date: Sun, 6 Jul 2025 17:18:21 -0500
Subject: [PATCH] Fix dark mode text styling - use correct lh-time and
 lh-duration CSS classes

---
 dvswitch/include/localtx.php | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/dvswitch/include/localtx.php b/dvswitch/include/localtx.php
index 129c866..40a575c 100644
--- a/dvswitch/include/localtx.php
+++ b/dvswitch/include/localtx.php
@@ -41,7 +41,7 @@ for ($i = 0; $i < count($localTXList); $i++) {
                                 $local_time = xstrftime('%H:%M:%S %b %d', $dt->getTimestamp());
 
 			echo"<tr>";
-			echo"<td align=\"left\" class=\"dark-mode-text\">&nbsp;$local_time</td>";
+			echo"<td align=\"left\" class=\"lh-time\">&nbsp;$local_time</td>";
 			echo"<td align=\"left\" style=\"color:green; font-weight:bold;\">&nbsp;$listElem[1]</td>";
 			    if (is_numeric($listElem[2]) || strpos($listElem[2], "openSPOT") !== FALSE) {
 				echo "<td align=\"left\" style=\"color:#464646;\"><b>&nbsp;$listElem[2]</b></td>";
@@ -63,11 +63,11 @@ for ($i = 0; $i < count($localTXList); $i++) {
 				echo "<td>$listElem[5]</td>";
 			}
 			if ($listElem[6] == null) {
-				echo "<td colspan=\"1\" style=\"background:#f33;\" class=\"dark-mode-text\">TX</td>";
+				echo "<td colspan=\"1\" style=\"background:#f33;\" class=\"lh-duration\">TX</td>";
 			} else if ($listElem[6] == "DMR Data") {
 				echo "<td colspan=\"1\" style=\"background:#1d1;\">DMR Data</td>";
 			}  else {
-		echo"<td class=\"dark-mode-text\">$listElem[6]</td>"; //duration
+		echo"<td class=\"lh-duration\">$listElem[6]</td>"; //duration
 		}
 			echo"</tr>\n";
 			$counter++; }
-- 
